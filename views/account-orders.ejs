<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
  <%- include('partials/theme-head') %>
  <style>body { font-family: 'Noto Sans TC', sans-serif; }</style>
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">

  <%- include('partials/age-modal') %>
  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-4xl mx-auto px-3 sm:px-6 py-8">

    <div class="mb-6 flex items-end justify-between">
      <div>
        <h1 class="text-2xl font-black text-white">我的訂單</h1>
        <p class="mt-1 text-sm text-gray-500">共 <%= total %> 張訂單</p>
      </div>
      <a href="/account" class="text-sm font-bold text-gold hover:text-wine-light">← 會員中心</a>
    </div>

    <% const sf = typeof statusFilter === 'string' ? statusFilter : ''; %>
    <%# 分段控件：全部 / 進行中 / 已完成（mobile segmented control pattern）%>
    <div class="mz-segmented mb-5" role="tablist" aria-label="訂單狀態範圍">
      <% const segs = [['','全部'],['active','進行中'],['completed','已完成']]; %>
      <% segs.forEach(([key,label]) => { %>
        <a role="tab" aria-selected="<%= sf===key ? 'true' : 'false' %>" href="?<%= key ? 'status='+key : '' %>" class="mz-segmented__item <%= sf===key ? 'is-active' : '' %>"><%= label %></a>
      <% }) %>
    </div>

    <% if (locals.error) { %>
      <div class="rounded-2xl border border-gold/40 bg-wine/15 p-4 text-sm text-wine-light"><%= error %></div>
    <% } else if (!orders || orders.length === 0) { %>
      <div class="rounded-2xl border border-ink-600 bg-ink-850 p-12 text-center shadow-sm">
        <span class="block text-6xl mb-4">📦</span>
        <h2 class="text-lg font-black text-white mb-1">你仲未有訂單</h2>
        <p class="text-sm text-gray-500 mb-6">睇睇有咩心水，揀好就可以落單。</p>
        <a href="/products" class="inline-block rounded-full bg-wine px-8 py-3 font-bold text-white hover:bg-wine transition">去購物</a>
      </div>
    <% } else { %>
      <%
        const payLabels = { bank_transfer: '銀行轉帳', fps: 'FPS 轉數快' };
        const payStatusLabels = { pending: '待付款', proof_pending: '憑證待確認', paid: '已付款', failed: '失敗', refunded: '已退款' };
        const shipStatusLabels = { pending: '待出貨', paid: '待出貨', shipping: '已出貨', shipped: '已出貨', delivered: '已送達', completed: '已完成', cancelled: '已取消' };
        const money = (v) => 'HK$' + Number(v || 0).toFixed(0);
      %>
      <div class="space-y-3">
        <% orders.forEach(o => { %>
          <%
            const orderNo = o.order_number || ('#' + o.id);
            const payBadge = o.payment_status === 'paid' ? 'bg-green-500/15 text-green-300'
              : o.payment_status === 'proof_pending' ? 'bg-purple-500/15 text-purple-300'
              : o.payment_status === 'pending' ? 'bg-amber-500/15 text-amber-300'
              : 'bg-ink-700 text-gray-400';
            const shipBadge = o.status === 'cancelled' ? 'bg-ink-700 text-gray-500'
              : o.status === 'completed' || o.status === 'delivered' ? 'bg-green-500/15 text-green-300'
              : o.status === 'shipping' || o.status === 'shipped' ? 'bg-blue-500/15 text-blue-300'
              : 'bg-amber-500/15 text-amber-300';
            const dateStr = (() => { try { return new Date(o.created_at).toLocaleDateString('zh-HK'); } catch(_) { return ''; } })();
          %>
          <a href="/order/<%= o.id %>"
             class="block rounded-2xl border border-ink-600 bg-ink-850 p-4 shadow-sm transition hover:border-gold/50 hover:shadow">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-ink-700 pb-3">
              <div class="flex items-center gap-2">
                <span class="font-black text-white"><%= orderNo %></span>
                <span class="text-xs text-gray-500"><%= dateStr %></span>
              </div>
              <div class="flex items-center gap-2 text-xs font-bold">
                <span class="rounded-full px-2 py-1 <%= payBadge %>"><%= payStatusLabels[o.payment_status] || o.payment_status || '待付款' %></span>
                <span class="rounded-full px-2 py-1 <%= shipBadge %>"><%= shipStatusLabels[o.status] || o.status || '待出貨' %></span>
              </div>
            </div>
            <% if (o.timeline) { %>
            <div class="border-b border-ink-700 pt-3 pb-3">
              <%- include('partials/order-timeline', { timeline: o.timeline }) %>
            </div>
            <% } %>
            <div class="flex flex-wrap items-center justify-between gap-2 pt-3 text-sm">
              <div class="text-gray-400">
                <%= o.item_qty || o.item_count || 0 %> 件商品
                <% if (o.payment_method_code) { %>· <%= payLabels[o.payment_method_code] || o.payment_method_code %><% } %>
                <% if (o.is_cod) { %>· <span class="text-orange-600 font-bold">運費到付</span><% } %>
              </div>
              <div class="font-black text-gold"><%= money(o.total_amount) %></div>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="mt-6 flex items-center justify-center gap-2 text-sm" aria-label="訂單分頁">
          <% if (page > 1) { %>
            <a aria-label="上一頁" class="inline-flex min-h-[44px] items-center rounded-full border border-gray-300 px-4 font-bold text-gray-300 transition hover:border-gold/50 hover:bg-wine/15 hover:text-wine-light" href="?page=<%= page - 1 %><%= sf ? '&status='+sf : '' %>">上一頁</a>
          <% } %>
          <span class="text-gray-500">第 <%= page %> / <%= totalPages %> 頁</span>
          <% if (page < totalPages) { %>
            <a aria-label="下一頁" class="inline-flex min-h-[44px] items-center rounded-full border border-gray-300 px-4 font-bold text-gray-300 transition hover:border-gold/50 hover:bg-wine/15 hover:text-wine-light" href="?page=<%= page + 1 %><%= sf ? '&status='+sf : '' %>">下一頁</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>

  </div>

  <%- include('partials/footer') %>
</body>
</html>
