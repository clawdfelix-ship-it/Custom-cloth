<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
  <%- include('partials/theme-head') %>
  <style>
    body { font-family: 'Noto Sans TC', sans-serif; }
    .jpn-bracket::before { content: '【'; }
    .jpn-bracket::after { content: '】'; }
  </style>
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">

  <%- include('partials/age-modal') %>
  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-3xl mx-auto px-3 sm:px-6 py-8">

    <% const orderError = locals.error || null; %>
    <% if (orderError || !order) { %>
      <div class="rounded-2xl border border-ink-600 bg-ink-850 p-10 text-center shadow-sm">
        <span class="text-6xl block mb-4">📦</span>
        <h1 class="text-2xl font-black text-white mb-2">搵唔到訂單</h1>
        <p class="text-gray-500 mb-6"><%= orderError || '訂單不存在或不屬於你' %></p>
        <a href="/products" class="inline-block rounded-full bg-wine px-8 py-3 text-white font-bold hover:bg-wine transition">繼續購物</a>
      </div>
    <% } else { %>
      <%
        // orders 表金額單位為 HKD（DECIMAL），唔係 cents
        const money = (v) => 'HK$' + Number(v || 0).toFixed(0);
        const payLabel = order.payment_method_code === 'fps' ? 'FPS 轉數快'
          : order.payment_method_code === 'bank_transfer' ? '銀行轉帳'
          : (order.payment_method_code || '—');
      %>

      <!-- 成功提示 -->
      <div class="mb-6 rounded-2xl border border-green-500/40 bg-green-500/10 p-5 text-center">
        <div class="text-4xl mb-2">✅</div>
        <h1 class="text-2xl font-black text-green-300">訂單已遞交！</h1>
        <p class="mt-1 text-sm text-green-300/90">
          訂單編號 <span class="font-black"><%= order.order_number || ('#' + order.id) %></span>
          ，請喺 24 小時內過數，入數後記得保留收據並聯絡我哋核實。
        </p>
      </div>

      <% if (order && order.timeline) { %>
      <div class="mb-6 rounded-2xl border border-ink-600 bg-ink-850 p-5 shadow-sm">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-base font-black text-white">訂單進度</h2>
          <span class="rounded-full px-3 py-1 text-xs font-bold <%= order.timeline.isCancelled ? 'bg-ink-700 text-gray-500' : 'bg-gold/15 text-gold-light' %>"><%= order.timeline.summary %></span>
        </div>
        <%- include('partials/order-timeline', { timeline: order.timeline }) %>
      </div>
      <% } %>

      <!-- 付款指示 -->
      <div class="mb-6 rounded-2xl border border-ink-600 bg-ink-850 p-6 shadow-sm">
        <h2 class="text-lg font-black text-white mb-4 jpn-bracket inline-block">付款方法：<%= payLabel %></h2>

        <% if (order.payment_method_code === 'fps') { %>
          <div class="space-y-2 text-sm text-gray-300">
            <% if (paymentInfo.fps.fpsId) { %><p>轉數快 FPS ID：<span class="font-black text-base"><%= paymentInfo.fps.fpsId %></span></p><% } %>
            <% if (paymentInfo.fps.fpsPhone) { %><p>轉數快電話：<span class="font-black text-base"><%= paymentInfo.fps.fpsPhone %></span></p><% } %>
            <% if (!paymentInfo.fps.fpsId && !paymentInfo.fps.fpsPhone) { %>
              <p class="text-amber-600">收款資料稍後由職員提供，請 WhatsApp 聯絡客服。</p>
            <% } %>
            <p class="text-gray-500">轉賬時請喺備註填訂單編號 <span class="font-bold"><%= order.order_number || ('#' + order.id) %></span>。</p>
          </div>
        <% } else { %>
          <div class="space-y-2 text-sm text-gray-300">
            <% if (paymentInfo.bank.bankName) { %><p>收款銀行：<span class="font-bold"><%= paymentInfo.bank.bankName %></span></p><% } %>
            <% if (paymentInfo.bank.accountName) { %><p>戶口名稱：<span class="font-bold"><%= paymentInfo.bank.accountName %></span></p><% } %>
            <% if (paymentInfo.bank.accountNumber) { %><p>戶口號碼：<span class="font-black text-base"><%= paymentInfo.bank.accountNumber %></span></p><% } %>
            <% if (!paymentInfo.bank.bankName && !paymentInfo.bank.accountNumber) { %>
              <p class="text-amber-600">收款戶口資料稍後由職員提供，請 WhatsApp 聯絡客服。</p>
            <% } %>
            <p class="text-gray-500">轉賬後請截圖入數記錄，連同訂單編號 <span class="font-bold"><%= order.order_number || ('#' + order.id) %></span> 一併發送。</p>
          </div>
        <% } %>
      </div>

      <!-- 入數證明上傳 -->
      <div class="mb-6 rounded-2xl border border-ink-600 bg-ink-850 p-6 shadow-card" id="proof-section">
        <h2 class="mz-display text-lg font-black text-white mb-2">上傳入數證明</h2>
        <p class="text-sm text-gray-400 mb-4">過數後，喺度上傳入數截圖／轉賬記錄，我哋核實後會更新訂單狀態。</p>

        <div id="proof-status-box" class="mb-4 hidden"></div>

        <form id="proof-form" enctype="multipart/form-data" class="space-y-4">
          <label class="block">
            <span class="text-xs font-semibold text-gray-400">選擇入數相（JPG / PNG，最多 8MB）</span>
            <input type="file" name="proof" id="proof-file" accept="image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif" required
              class="mt-2 block w-full text-sm text-gray-300 file:mr-3 file:rounded-full file:border-0 file:bg-ink-700 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-gold hover:file:bg-ink-600">
          </label>
          <button type="submit" id="proof-submit" class="rounded-full bg-wine px-6 py-3 text-sm font-bold text-white shadow-glow transition hover:bg-wine-light disabled:opacity-50">提交入數證明</button>
        </form>
      </div>

      <!-- 商品 -->
      <div class="mb-6 rounded-2xl border border-ink-600 bg-ink-850 p-6 shadow-sm">
        <h2 class="text-lg font-black text-white mb-4">訂單商品</h2>
        <div class="divide-y divide-ink-700">
          <% (items || []).forEach(item => { %>
            <div class="flex items-center gap-4 py-3">
              <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-ink-700">
                <% if (item.image_url) { %>
                  <img src="<%= item.image_url %>" alt="" loading="lazy" decoding="async" class="h-full w-full object-contain p-0.5">
                <% } else { %>📦<% } %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-bold text-white"><%= item.product_name || ('商品 #' + item.product_id) %></p>
                <p class="text-xs text-gray-500"><%= money(item.unit_price) %> × <%= item.quantity %></p>
              </div>
              <p class="text-sm font-black text-white"><%= money(Number(item.unit_price) * Number(item.quantity)) %></p>
            </div>
          <% }) %>
        </div>

        <div class="mt-4 space-y-2 border-t border-ink-700 pt-4 text-sm">
          <div class="flex justify-between text-gray-400">
            <span>商品小計</span><span class="font-bold text-white"><%= money(order.subtotal_amount) %></span>
          </div>
          <div class="flex justify-between text-gray-400">
            <span>運費</span>
            <span class="font-bold text-orange-600">到付（貨到時另行支付）</span>
          </div>
          <div class="flex justify-between border-t border-ink-700 pt-2 text-base">
            <span class="font-black text-white">而家需付款</span>
            <span class="font-black text-gold"><%= money(order.total_amount) %></span>
          </div>
        </div>
      </div>

      <!-- 送貨資料 -->
      <div class="mb-6 rounded-2xl border border-ink-600 bg-ink-850 p-6 shadow-sm text-sm">
        <h2 class="text-lg font-black text-white mb-4">送貨資料</h2>
        <dl class="space-y-2 text-gray-300">
          <div class="flex gap-3"><dt class="w-20 flex-shrink-0 text-gray-500">收件人</dt><dd class="font-bold"><%= order.contact_name %></dd></div>
          <div class="flex gap-3"><dt class="w-20 flex-shrink-0 text-gray-500">電話</dt><dd class="font-bold"><%= order.contact_phone %></dd></div>
          <div class="flex gap-3"><dt class="w-20 flex-shrink-0 text-gray-500">地址</dt><dd class="font-bold"><%= order.contact_address %></dd></div>
          <% if (order.note) { %>
            <div class="flex gap-3"><dt class="w-20 flex-shrink-0 text-gray-500">備註</dt><dd><%= order.note %></dd></div>
          <% } %>
        </dl>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/products" class="flex-1 rounded-full bg-wine py-3 text-center font-bold text-white hover:bg-wine transition">繼續購物</a>
      </div>
    <% } %>

  </div>

  <script>
    (function(){
      const orderId = <%= order ? order.id : 'null' %>;
      const section = document.getElementById('proof-section');
      if (!orderId || !section) return;
      const form = document.getElementById('proof-form');
      const fileInput = document.getElementById('proof-file');
      const submitBtn = document.getElementById('proof-submit');
      const box = document.getElementById('proof-status-box');

      const STATES = {
        pending: {cls:'border-gold/40 bg-wine/15 text-gold-light', label:'待上傳／等待核實'},
        proof_pending: {cls:'border-gold/40 bg-wine/15 text-gold-light', label:'已上傳憑證，等待職員確認'},
        paid: {cls:'border-green-500/40 bg-green-500/10 text-green-300', label:'已確認收款'},
      };

      function renderState(paymentStatus, proof){
        // 已收款：隱藏上傳表
        if (paymentStatus === 'paid') {
          form.classList.add('hidden');
          box.classList.remove('hidden');
          box.className = 'mb-4 rounded-xl border px-4 py-3 text-sm font-semibold ' + STATES.paid.cls;
          box.textContent = '✓ 已確認收款，多謝！訂單將安排出貨。';
          return;
        }
        // 被駁回：提示重傳 + 原因
        if (proof && proof.status === 'rejected') {
          form.classList.remove('hidden');
          box.classList.remove('hidden');
          box.className = 'mb-4 rounded-xl border border-gold/50 bg-wine/15 px-4 py-3 text-sm text-wine-light';
          box.innerHTML = '<div class="font-bold">憑證被駁回，請重新上傳</div>' +
            (proof.reject_reason ? '<div class="mt-1 text-gray-300">原因：' + escapeHtml(proof.reject_reason) + '</div>' : '');
          return;
        }
        // 等待確認
        if (paymentStatus === 'proof_pending') {
          form.classList.add('hidden');
          box.classList.remove('hidden');
          box.className = 'mb-4 rounded-xl border px-4 py-3 text-sm font-semibold ' + STATES.proof_pending.cls;
          box.textContent = '⏳ 已收到你嘅入數證明，職員確認後會更新狀態。';
          return;
        }
      }

      function escapeHtml(s){
        return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      }

      // 上傳前自動縮細壓縮，避開 Vercel 4.5MB 上限；HEIC 等一律經 canvas 轉 JPEG
      async function compressImage(file){
        const MAX_BYTES = 3.8 * 1024 * 1024;
        // 細圖直接用（但仍統一類型為 JPEG，避免罕見格式被拒）
        if (file.size <= MAX_BYTES && /image\/(jpeg|png|gif|webp)/.test(file.type)) return file;

        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        let { width, height } = bmp;
        const MAX_DIM = 2048;
        if (Math.max(width, height) > MAX_DIM) {
          const k = MAX_DIM / Math.max(width, height);
          width = Math.round(width * k);
          height = Math.round(height * k);
        }
        const canvas = document.createElement('canvas');
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, width, height);
        ctx.drawImage(bmp, 0, 0, width, height);

        let quality = 0.9;
        let blob = await new Promise(res => canvas.toBlob(res, 'image/jpeg', quality));
        while (blob.size > MAX_BYTES && quality > 0.4) {
          quality -= 0.15;
          blob = await new Promise(res => canvas.toBlob(res, 'image/jpeg', quality));
        }
        return new File([blob], (file.name || 'proof').replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' });
      }

      async function refresh(){
        try {
          const r = await fetch('/api/orders/' + orderId + '/proof', {credentials:'same-origin'});
          if (!r.ok) return;
          const d = await r.json();
          renderState(d.payment_status, d.proof);
        } catch(e){}
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!fileInput.files.length) return;
        submitBtn.disabled = true;
        submitBtn.textContent = '處理圖片中…';
        try {
          let outFile;
          try {
            outFile = await compressImage(fileInput.files[0]);
          } catch (ce) {
            // 某些瀏覽器讀唔到 HEIC：提示轉格式
            throw new Error('讀唔到張圖，請改用 JPG／PNG，或先截圖再上傳');
          }
          submitBtn.textContent = '上傳中…';
          const fd = new FormData();
          fd.append('proof', outFile);
          const hdrs = {};
          const tok = document.querySelector('meta[name=csrf-token]')?.content;
          if (tok) hdrs['csrf-token'] = tok;
          const r = await fetch('/api/orders/' + orderId + '/proof', {method:'POST', body:fd, headers:hdrs, credentials:'same-origin'});
          const d = await r.json().catch(()=>({}));
          if (!r.ok) throw new Error(d.error || '上傳失敗');
          fileInput.value = '';
          await refresh();
        } catch(err){
          box.classList.remove('hidden');
          box.className = 'mb-4 rounded-xl border border-gold/50 bg-wine/15 px-4 py-3 text-sm text-wine-light';
          box.textContent = err.message;
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = '提交入數證明';
        }
      });

      refresh();
    })();
  </script>

  <%- include('partials/footer') %>
</body>
</html>
