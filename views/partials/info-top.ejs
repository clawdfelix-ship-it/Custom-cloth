<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · OHYA2.0</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('theme-head') %>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="robots" content="index,follow">
  <style>
    /* 暗色資訊頁排版：沿用 ink/wine/gold tokens，長文保持高對比可讀 */
    .info-card h2 { font-size: 1.25rem; font-weight: 800; color: #fff; margin: 1.75rem 0 .6rem; }
    .info-card h2:first-child { margin-top: 0; }
    .info-card h3 { font-size: 1.05rem; font-weight: 700; color: #f3f4f6; margin: 1.1rem 0 .4rem; }
    .info-card p { color: #d1d5db; line-height: 1.85; margin: .5rem 0; }
    .info-card strong { color: #f3f4f6; font-weight: 700; }
    .info-card ul { list-style: disc; padding-left: 1.4rem; color: #d1d5db; line-height: 1.9; margin: .5rem 0; }
    .info-card ol { list-style: decimal; padding-left: 1.4rem; color: #d1d5db; line-height: 1.9; margin: .5rem 0; }
    .info-card a { color: var(--tw-prose-links, #e0c084); color: #e0c084; text-decoration: underline; text-underline-offset: 2px; }
    .info-card a:hover { color: #c8a45d; }
    .info-card table { width: 100%; border-collapse: collapse; margin: .75rem 0; font-size: .92rem; }
    .info-card th, .info-card td { border: 1px solid #2a2a35; padding: .55rem .7rem; text-align: left; vertical-align: top; }
    .info-card th { background: #16161d; color: #f3f4f6; font-weight: 700; }
    .info-card td { color: #d1d5db; }
    .info-card blockquote { border-left: 3px solid #c8a45d; background: #111116; padding: .7rem 1rem; margin: .8rem 0; color: #d1d5db; border-radius: 0 8px 8px 0; }
  </style>
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">

  <%- include('age-modal') %>
  <%- include('header') %>

  <div id="mz-wrapper" class="mz-wrapper max-w-7xl mx-auto px-2 mt-4 mb-4">
    <div class="mz-3col">
      <%- include('sidebar-left') %>

      <div id="wrap_center" class="min-w-0">
        <div class="max-w-4xl mx-auto px-0 sm:px-4 lg:px-6 py-6">
          <nav class="mb-3 text-xs text-gray-500" aria-label="麵包屑">
            <a href="/" class="hover:text-gold-light">首頁</a>
            <span class="mx-1">/</span>
            <span class="text-gray-300"><%= title %></span>
          </nav>
          <h1 class="mz-display text-2xl sm:text-3xl font-black text-white mb-1 jpn-bracket inline-block"><%= title %></h1>
          <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
            <p class="mt-3 mb-5 text-sm text-gray-400"><%= pageSubtitle %></p>
          <% } else { %>
            <div class="mb-5"></div>
          <% } %>
          <div class="info-card rounded-2xl border border-ink-600 bg-ink-850 p-5 sm:p-8 text-[15px] shadow-card">
