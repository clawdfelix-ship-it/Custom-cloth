          </div>

          <% const infoLinks = [
            { href: '/help', label: '顧客須知' },
            { href: '/shipping', label: '送貨安排' },
            { href: '/payment', label: '付款方式' },
            { href: '/returns', label: '退換須知' },
            { href: '/faq', label: '常見問題' },
            { href: '/wholesale', label: '批發分銷' },
            { href: '/contact', label: '聯絡我們' },
            { href: '/terms', label: '服務條款' },
            { href: '/privacy', label: '私隱政策' },
          ]; %>
          <div class="mt-6 rounded-2xl border border-ink-600 bg-ink-850 p-5 shadow-card">
            <div class="mb-3 text-sm font-bold text-white">相關資訊</div>
            <div class="flex flex-wrap gap-2">
              <% infoLinks.forEach((l) => { const active = (typeof activeInfoKey !== 'undefined' && activeInfoKey === l.href); %>
                <a href="<%= l.href %>" class="rounded-full border px-3 py-1.5 text-xs font-semibold transition <%= active ? 'border-gold bg-gold/15 text-gold-light' : 'border-ink-600 text-gray-300 hover:border-gold/50 hover:text-gold-light' %>"><%= l.label %></a>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <%- include('sidebar-right') %>
    </div>
  </div>

  <%- include('footer') %>

  <script>
    if (typeof checkAgeVerification === 'function') {
      document.addEventListener('DOMContentLoaded', checkAgeVerification);
    }
  </script>
</body>
</html>
