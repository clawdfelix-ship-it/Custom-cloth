<% const _hm = typeof homeModules !== 'undefined' && homeModules ? homeModules : {}; %>
<% const rightModules = Array.isArray(_hm.right) && _hm.right.length ? _hm.right : [
  { key: 'fallback-right-1', href: '/products?page=1', image_url: '/assets/mzakka/banners/214_78(1).png', title: '推薦' },
]; %>
<aside id="wrap_right" class="lg:w-56 flex-shrink-0">
  <div class="mb-3 overflow-hidden rounded-2xl border border-ink-600 bg-ink-850">
    <div class="mz-sidebar-title border-b border-ink-600 px-3 py-2 text-xs font-black text-gold">【最近瀏覽】</div>
    <div class="p-3 text-xs text-gray-400">
      <div id="mz-recently-viewed-empty">暫時未有</div>
      <ul id="mz-recently-viewed" class="hidden space-y-2"></ul>
    </div>
  </div>

  <div class="overflow-hidden rounded-2xl border border-ink-600 bg-ink-850">
    <div class="mz-sidebar-title border-b border-ink-600 px-3 py-2 text-xs font-black text-gold">【推薦】</div>
    <div class="p-2">
      <% rightModules.forEach(module => { %>
        <a href="<%= module.href || '/products?page=1' %>" class="block overflow-hidden rounded-xl border border-ink-600 bg-ink-800 transition hover:border-gold/50">
          <img src="<%= module.image_url %>" alt="<%= module.title || '推薦' %>" loading="lazy" decoding="async" class="w-full">
        </a>
      <% }) %>
    </div>
  </div>
</aside>
