<%# 手機底部 Tab bar（mobile pattern）：首頁 / 分類 / 購物車 / 會員。
    lg 以上隱藏（header/sidebar 已 cover）。fixed bottom，需要時 JS 可加 body padding。
    active 狀態由 path 判斷；badge 用 data-cart-badge，cart-client 會一齊更新。
    「分類」直接開商品分類 BottomSheet（資料島全頁通用）。 %>
<%
  const tabPath = String(typeof tabActivePath === 'string' ? tabActivePath : (typeof currentPath === 'string' ? currentPath : ''));
  const tabIs = function (key) {
    if (key === 'home') return tabPath === '/' ;
    if (key === 'products') return tabPath.indexOf('/products') === 0 || tabPath.indexOf('/product/') === 0;
    if (key === 'cart') return tabPath.indexOf('/cart') === 0;
    if (key === 'account') return tabPath.indexOf('/account') === 0 || tabPath.indexOf('/login') === 0;
    return false;
  };
  const tabCls = function (key) {
    return 'mz-tabbar__item' + (tabIs(key) ? ' is-active' : '');
  };
  const tabUser = typeof user !== 'undefined' && user;
%>
<nav class="mz-tabbar lg:hidden" aria-label="主選單">
  <a class="<%= tabCls('home') %>" href="/">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>
    <span>首頁</span>
  </a>
  <button type="button" class="<%= tabCls('products') %>" data-category-tab-open aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    <span>分類</span>
  </button>
  <a class="<%= tabCls('cart') %>" href="/cart">
    <span class="mz-tabbar__badgewrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2 3h3l2.4 12.4a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.2L22 7H6"/></svg>
      <span class="mz-tabbar__badge" data-cart-badge hidden>0</span>
    </span>
    <span>購物車</span>
  </a>
  <% if (tabUser) { %>
    <a class="<%= tabCls('account') %>" href="/account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
      <span>會員</span>
    </a>
  <% } else { %>
    <a class="<%= tabCls('account') %>" href="/login">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
      <span>登入</span>
    </a>
  <% } %>
</nav>

<%# 全頁通用嘅分類資料島：tabbar「分類」直接開 BottomSheet。
   bottom-sheet.css + category-sheet.js 都要全頁載入。 %>
<link rel="stylesheet" href="/css/bottom-sheet.css">
<script type="application/json" data-category-tree-json>
<%-
  JSON.stringify({
    tree: Array.isArray(categoriesTree) ? categoriesTree : [],
    specials: Array.isArray(categorySpecials) ? categorySpecials : [],
    active: typeof selectedCategorySlug === 'string' ? selectedCategorySlug : null,
    allCount: (Array.isArray(categories) && categories[0] && categories[0].count) || 0,
  })
%>
</script>
<script src="/js/bottom-sheet.js"></script>
<script src="/js/category-sheet.js"></script>
