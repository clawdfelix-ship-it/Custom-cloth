<header class="site-header">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4">
    <a href="/customizer" class="flex items-center gap-3" aria-label="<%= siteName || 'Custom Cloth' %> 首頁">
      <span class="site-logo-mark">CC</span>
      <span>
        <span class="block text-xs font-semibold uppercase tracking-[0.28em] text-amber-300">Custom Cloth</span>
        <span class="block text-sm font-semibold text-zinc-200">團體服訂製器</span>
      </span>
    </a>

    <nav class="flex flex-wrap items-center gap-2 text-sm">
      <a href="/customizer" class="site-nav-link <%= currentPath === '/customizer' ? 'is-active' : '' %>">首頁</a>
      <a href="/customizer/editor?startMode=template" class="site-nav-link <%= currentPath === '/customizer/editor' ? 'is-active' : '' %>">模板開始</a>
      <a href="/customizer/editor?startMode=blank" class="site-nav-link <%= currentPath === '/customizer/editor' ? 'is-active' : '' %>">空白款開始</a>
