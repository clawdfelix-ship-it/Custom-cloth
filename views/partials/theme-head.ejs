            dark: '#7c152e',
          },
          gold: {
            DEFAULT: '#c8a45d',
            light: '#e0c084',
            dark: '#a8853f',
          },
        },
        fontFamily: {
          sans: ['"Noto Sans TC"', 'sans-serif'],
          serif: ['"Noto Serif TC"', 'serif'],
        },
        boxShadow: {
          luxe: '0 18px 50px -18px rgba(0,0,0,0.75)',
          card: '0 10px 30px -16px rgba(0,0,0,0.7)',
          glow: '0 0 0 1px rgba(200,164,93,0.25), 0 12px 40px -12px rgba(160,30,61,0.45)',
        },
      },
    },
