<style>
  body { font-family: 'Noto Sans TC', sans-serif; }
  /* 暗色底層氣氛：頂部一層極弱酒紅光晕，增添私密奢華感 */
  .mz-body {
    background:
      radial-gradient(1100px 520px at 50% -12%, rgba(160,30,61,0.18), transparent 60%),
      #08080b;
    color: #ececed;
  }
  .mz-display { font-family: 'Noto Serif TC', serif; letter-spacing: 0.01em; }
  /* 金色細分隔線 */
  .mz-rule-gold { height:1px; background: linear-gradient(90deg, transparent, rgba(200,164,93,0.55), transparent); }
  /* 商品圖喺暗色下嘅中性托底 */
  .mz-imgwell { background: #101015; }
  .jpn-bracket::before { content: '【'; }
  .jpn-bracket::after { content: '】'; }
  .product-grid { gap: 0.75rem; }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .modal-animate { animation: slideDown 0.3s ease-out; }
