<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <%- include('../partials/head', { title }) %>
  <link rel="stylesheet" href="/css/customizer.css">
</head>
<body class="min-h-screen text-zinc-100">
  <%- include('../partials/header') %>

  <main class="mx-auto max-w-7xl px-4 py-8">
    <section class="rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-2xl shadow-black/20">
      <div class="max-w-4xl">
        <div class="text-xs font-bold uppercase tracking-[0.24em] text-gold">Customizer</div>
        <h1 class="mt-2 text-3xl font-black text-white">團體服訂製器</h1>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-gray-400">
          由模板家族開始或者由空白家族開始，逐步揀 body、sleeve、collar，再做配色、logo、字樣同 roster。
          呢個版本會朝住 fifakitcreator 嗰種模板玩法重建。
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        <% ['足球', '籃球', '排球', '背心', 'Polo'].forEach((name) => { %>
          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <div class="text-lg font-bold text-white"><%= name %></div>
            <div class="mt-2 text-sm text-gray-400">選擇模板家族後進入即時編輯器。</div>
          </div>
        <% }) %>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/customizer/editor?startMode=template" class="rounded-full bg-rose-800 px-5 py-3 text-sm font-bold text-white transition hover:bg-rose-700">模板開始</a>
        <a href="/customizer/editor?startMode=blank" class="rounded-full border border-white/15 px-5 py-3 text-sm font-bold text-zinc-200 transition hover:border-amber-300/60 hover:text-amber-200">空白款開始</a>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
