<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <%- include('../partials/head', { title }) %>
  <link rel="stylesheet" href="/css/customizer.css">
</head>
<body class="min-h-screen text-zinc-100">
  <%- include('../partials/header') %>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <section class="rounded-3xl border border-white/10 bg-white/5 p-8 text-center shadow-2xl shadow-black/20">
      <div class="text-xs font-bold uppercase tracking-[0.18em] text-gold">Submitted</div>
      <h1 class="mt-2 text-3xl font-black text-white">報價請求已提交</h1>
      <p class="mt-4 text-sm leading-7 text-gray-400">
        我哋已經收到你嘅設計、效果圖同 roster。下一步會由後台覆核價格與交期。
        <% if (quoteId) { %>報價編號：<span class="font-bold text-white">#<%= quoteId %></span><% } %>
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/customizer" class="rounded-full bg-rose-800 px-5 py-3 text-sm font-bold text-white transition hover:bg-rose-700">返回訂製器</a>
        <a href="/customizer/editor?startMode=template" class="rounded-full border border-white/15 px-5 py-3 text-sm font-bold text-zinc-200 transition hover:border-amber-300/60 hover:text-amber-200">繼續修改設計</a>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
