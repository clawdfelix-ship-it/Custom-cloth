<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>會員中心 · OHYA2.0</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-head') %>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="1">

  <%- include('partials/header') %>

  <main class="mx-auto max-w-7xl px-4 py-8">
    <div class="mb-6">
      <p class="text-xs font-bold uppercase tracking-[0.28em] text-gold">My Account</p>
      <h1 class="mz-display mt-2 text-3xl font-black text-white">會員中心</h1>
    </div>

    <!-- 賬戶資料卡 -->
    <section class="mb-6 rounded-3xl border border-ink-600 bg-ink-850 p-6 shadow-card">
      <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-wine/20 text-lg font-black text-gold-light"><%= (accountUser.username || '客').charAt(0) %></span>
            <div>
              <div id="display-username" class="text-lg font-bold text-white"><%= accountUser.username %></div>
              <div class="text-sm text-gray-400"><%= accountUser.email %></div>
            </div>
          </div>
          <div class="mt-3 text-xs text-gray-500">入會日期：<%= new Date(accountUser.created_at).toLocaleDateString('zh-HK') %></div>
        </div>

        <form id="profile-form" class="flex flex-wrap items-center gap-2">
          <input type="text" name="username" id="profile-username" value="<%= accountUser.username %>" maxlength="50"
            class="w-40 rounded-full border border-ink-600 bg-ink-800 px-4 py-2 text-sm text-gray-100 focus:border-gold/60 focus:outline-none">
          <button type="submit" class="rounded-full border border-gold/50 px-5 py-2 text-xs font-semibold text-gold-light transition hover:bg-gold/10">更新稱謂</button>
        </form>
      </div>
    </section>

    <!-- 積分卡 -->
    <% if (pointsCfg && pointsCfg.enabled) { %>
    <% const ptTypeLabels = { earn:'賺取', redeem:'兌換', adjust:'調整', revoke:'追回', expire:'過期', birthday:'生日' }; %>
    <section class="mb-6 overflow-hidden rounded-3xl border border-gold/40 bg-gradient-to-br from-ink-850 to-ink-900 shadow-glow">
      <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.28em] text-gold">My Points</p>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="text-4xl font-black text-gold-light"><%= pointsBalance %></span>
            <span class="text-sm text-gray-400">可用積分</span>
          </div>
          <p class="mt-2 text-xs text-gray-500">
            每消費 HK$<%= pointsCfg.earnHkd %> 賺 1 分；每 <%= pointsCfg.redeemHkd %> 分喺結帳即減 HK$1。
          </p>
        </div>
        <a href="/cart" class="rounded-full bg-wine px-6 py-3 text-sm font-bold text-white shadow hover:bg-wine-light">去購物車用積分</a>
      </div>
      <div class="border-t border-ink-700 px-6 py-4">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-sm font-black text-white">積分流水</h2>
          <span class="text-xs text-gray-500">最近 <%= pointsHistory.length %> 筆</span>
        </div>
        <% if (!pointsHistory.length) { %>
          <div class="py-6 text-center text-sm text-gray-500">仲未有積分記錄，完成訂單後就會喺呢度顯示</div>
        <% } else { %>
        <div class="divide-y divide-ink-700">
          <% pointsHistory.forEach(function(pt){
            const pts = parseInt(pt.points, 10);
          %>
            <div class="flex items-center justify-between gap-3 py-2.5 text-sm">
              <div class="min-w-0">
                <div class="font-semibold text-gray-200"><%= ptTypeLabels[pt.type] || pt.type %></div>
                <div class="truncate text-xs text-gray-500"><%= pt.description || '' %></div>
              </div>
              <div class="shrink-0 text-right">
                <div class="font-black <%= pts > 0 ? 'text-green-300' : 'text-red-300' %>"><%= pts > 0 ? '+' : '' %><%= pts %></div>
                <div class="text-[11px] text-gray-500"><%= new Date(pt.created_at).toLocaleDateString('zh-HK') %></div>
              </div>
            </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <!-- 訂單狀態統計 -->
    <section class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-5">
      <% const cards = [
        { key:'pending_pay', label:'待付款', value:stats.pending_pay, href:'/account/orders?status=pending' },
        { key:'pending_ship', label:'待出貨', value:stats.pending_ship, href:'/account/orders?status=unshipped' },
        { key:'shipped', label:'待收貨', value:stats.shipped, href:'/account/orders?status=shipping' },
        { key:'completed', label:'已完成', value:stats.completed, href:'/account/orders?status=completed' },
        { key:'cancelled', label:'已取消', value:stats.cancelled, href:'/account/orders?status=cancelled' },
      ]; %>
      <% cards.forEach(c => { %>
        <a href="<%= c.href %>" class="rounded-2xl border border-ink-600 bg-ink-850 p-5 transition hover:border-gold/50 hover:shadow-glow">
          <div class="text-3xl font-black text-white"><%= c.value %></div>
          <div class="mt-2 text-sm text-gray-400"><%= c.label %></div>
        </a>
      <% }) %>
    </section>

    <!-- 最近訂單 -->
    <section class="mb-6 overflow-hidden rounded-3xl border border-ink-600 bg-ink-850 shadow-card">
      <div class="flex items-center justify-between border-b border-ink-600 px-6 py-4">
        <h2 class="mz-display text-lg font-black text-white">最近訂單</h2>
        <a href="/account/orders" class="text-sm font-semibold text-gold-light hover:text-gold">查看全部</a>
      </div>
      <div class="divide-y divide-ink-700">
        <% if (!recentOrders.length) { %>
          <div class="px-6 py-10 text-center text-sm text-gray-500">
            暫時未有訂單
            <a href="/products" class="mt-3 inline-block rounded-full bg-wine px-5 py-2 text-xs font-bold text-white">立即選購</a>
          </div>
        <% } %>
        <% recentOrders.forEach(o => {
          const statusLabels = { pending:'處理中', paid:'待出貨', shipping:'已出貨', completed:'已完成', cancelled:'已取消' };
          const payBadge = o.payment_status === 'paid' ? 'bg-green-500/15 text-green-300'
            : o.payment_status === 'proof_pending' ? 'bg-wine/20 text-gold-light'
            : 'bg-amber-500/15 text-amber-300';
          const payLabels = { pending:'待付款', proof_pending:'憑證待確認', paid:'已付款' };
        %>
          <a href="/order/<%= o.id %>" class="flex flex-col gap-3 px-6 py-4 transition hover:bg-ink-700/60 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="text-sm font-bold text-gray-100"><%= o.order_number %></div>
              <div class="mt-1 text-xs text-gray-500"><%= new Date(o.created_at).toLocaleString('zh-HK') %></div>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full px-3 py-1 text-[11px] font-semibold <%= payBadge %>"><%= payLabels[o.payment_status] || o.payment_status %></span>
              <span class="text-sm font-black text-wine-light">$<%= Number(o.total_amount).toFixed(2) %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    (function(){
      const form = document.getElementById('profile-form');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('profile-username');
        const tok = document.querySelector('meta[name=csrf-token]')?.content || '';
        const r = await fetch('/api/account/profile', {
          method:'POST',
          headers:{'content-type':'application/json','csrf-token':tok},
          body: JSON.stringify({ username: input.value }),
          credentials:'same-origin',
        });
        const d = await r.json().catch(()=>({}));
        if (r.ok) {
          document.getElementById('display-username').textContent = d.username;
        } else {
          alert(d.error || '更新失敗');
        }
      });
    })();
  </script>
</body>
</html>
