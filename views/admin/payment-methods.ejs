<div id="admin-payment-methods" class="space-y-3">
  <div id="pm-error" class="admin-error hidden"></div>

  <div class="flex flex-wrap gap-2 items-center justify-between">
    <div class="font-bold">支付方式列表</div>
    <button id="pm-create" class="admin-btn" type="button">新增支付方式</button>
  </div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>名稱</th>
          <th>代碼</th>
          <th>服務商</th>
          <th>手續費 %</th>
          <th>固定手續費</th>
          <th>排序</th>
          <th>狀態</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="pm-tbody"></tbody>
    </table>
  </div>

  <!-- ============ 新增 / 編輯支付方式彈窗 ============ -->
  <div id="pm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="pm-modal-title">新增 / 編輯支付方式</div>
        <button id="pm-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-2 gap-2">
          <input id="pm-id" class="admin-input hidden" />
          <input id="pm-name" class="admin-input col-span-2" placeholder="支付方式名稱（例如：轉數快 FPS）" />
          <input id="pm-code" class="admin-input" placeholder="代碼（唯一，例如 fps / payme）" />
          <input id="pm-provider" class="admin-input" placeholder="服務商（可留空）" list="pm-provider-list" />
          <datalist id="pm-provider-list">
            <option value="fps"></option>
            <option value="payme"></option>
            <option value="alipayhk"></option>
            <option value="wechatpayhk"></option>
            <option value="stripe"></option>
            <option value="paypal"></option>
            <option value="cod"></option>
          </datalist>
          <input id="pm-fee-percent" class="admin-input" type="number" min="0" step="0.01" placeholder="手續費百分比 %（可留空）" />
          <input id="pm-fee-fixed" class="admin-input" type="number" min="0" step="0.01" placeholder="固定手續費 HK$（可留空）" />
          <input id="pm-sort" class="admin-input" type="number" step="1" placeholder="排序（數字細排前）" />
          <input id="pm-qr-image" class="admin-input col-span-2" placeholder="收款 QR 碼圖片網址（可留空）" />
          <textarea id="pm-instructions" class="admin-input col-span-2" rows="3" placeholder="付款指示（例如轉數快 FPS ID，可留空）"></textarea>
          <label class="text-sm col-span-2 flex items-center gap-2">
            <input id="pm-active" type="checkbox" />
            <span>啟用</span>
          </label>
        </div>
        <div class="flex gap-2 pt-2">
          <button id="pm-save" class="admin-btn" type="button">儲存</button>
          <button id="pm-reset" class="admin-btn-secondary" type="button">清空</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/payment-methods.js"></script>
</div>
