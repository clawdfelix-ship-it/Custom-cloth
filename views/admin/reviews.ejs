<div id="admin-reviews" class="space-y-3">
  <div id="reviews-error" class="admin-error hidden"></div>

  <div class="admin-card space-y-2">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div>
        <div class="font-bold">待審核評價</div>
        <div class="text-sm" style="color: var(--ad-muted);">
          審核用戶提交嘅產品評價，核准後先會喺店面顯示同計入產品評分。
        </div>
      </div>
      <button id="reviews-refresh" class="admin-btn-secondary" type="button">重新整理</button>
    </div>
  </div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>產品</th>
          <th>會員</th>
          <th>評分</th>
          <th>評價內容</th>
          <th>提交時間</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="reviews-tbody"></tbody>
    </table>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/reviews.js"></script>
</div>
