<div id="admin-products" class="space-y-3">
  <div class="flex flex-wrap gap-2 items-end">
    <label class="text-sm">
      <div class="mb-1">搜尋</div>
      <input id="products-search" class="admin-input" placeholder="商品名/描述" />
    </label>
    <label class="text-sm">
      <div class="mb-1">分類</div>
      <select id="products-category" class="admin-input"></select>
    </label>
    <button id="products-refresh" class="admin-btn">刷新</button>
    <button id="products-sync" class="admin-btn-secondary" type="button">同步 M-ZAKKA 新品</button>
    <button id="products-new" class="admin-btn">新增商品</button>
  </div>

  <div id="products-error" class="admin-error hidden"></div>
  <div id="products-sync-result" class="hidden rounded border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800"></div>

  <div class="admin-card">
    <!-- 手機版：商品卡片列表 -->
    <div id="products-mobile-card" class="products-mobile-card">
      <div id="products-cards" class="space-y-3"></div>
      <div id="products-empty" class="hidden py-8 text-center text-sm text-gray-500">搵唔到相關商品</div>
    </div>
    <!-- 桌面版：表格 -->
    <div class="products-table-card overflow-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>商品</th>
            <th>分類</th>
            <th>成本/批發/零售</th>
            <th>庫存</th>
            <th>狀態</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="products-tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- ============ 商品編輯彈窗（一㩒編輯即喺眼前打開） ============ -->
  <div id="product-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="product-modal-title">商品編輯</div>
        <button id="product-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>

      <div class="p-4">
        <form id="product-form" class="space-y-2">
          <input type="hidden" id="product-id" />
          <label class="text-sm block">
            <div class="mb-1">名稱</div>
            <input id="product-name" class="admin-input w-full" required />
          </label>
          <label class="text-sm block">
            <div class="mb-1">Slug</div>
            <input id="product-slug" class="admin-input w-full" />
          </label>
          <div class="grid grid-cols-2 gap-2">
            <label class="text-sm block">
              <div class="mb-1">主分類</div>
              <select id="product-parent-category" class="admin-input w-full"></select>
            </label>
            <label class="text-sm block">
              <div class="mb-1">子分類</div>
              <select id="product-category" class="admin-input w-full"></select>
            </label>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <label class="text-sm block">
              <div class="mb-1">售價</div>
              <input id="product-price" class="admin-input w-full" type="number" step="0.01" required />
            </label>
            <label class="text-sm block">
              <div class="mb-1">原價（可選）</div>
              <input id="product-original-price" class="admin-input w-full" type="number" step="0.01" />
            </label>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="text-sm block">
              <div class="mb-1">庫存（SKU 合計）</div>
              <div id="product-total-stock" class="admin-input w-full bg-gray-50">—</div>
            </div>
            <label class="text-sm block">
              <div class="mb-1">狀態</div>
              <select id="product-status" class="admin-input w-full">
                <option value="active">上架</option>
                <option value="inactive">下架</option>
              </select>
            </label>
          </div>
          <label class="text-sm block">
            <div class="mb-1">主圖 URL（或上傳）</div>
            <input id="product-image-url" class="admin-input w-full" placeholder="/images/xxx.jpg 或 https://..." />
          </label>
          <label class="text-sm block">
            <div class="mb-1">上傳主圖</div>
            <input id="product-image-file" class="admin-input w-full" type="file" accept="image/*" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">簡短描述（繁中）</div>
            <textarea id="product-short-desc" class="admin-input w-full" rows="2"></textarea>
          </label>
          <label class="text-sm block">
            <div class="mb-1">詳細描述（繁中）</div>
            <textarea id="product-desc" class="admin-input w-full" rows="5"></textarea>
          </label>
          <div id="sku-management" class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="font-bold">SKU 管理</div>
              <button id="sku-add" class="admin-btn-secondary" type="button">新增 SKU</button>
            </div>
            <div id="sku-empty-hint" class="text-sm text-gray-600">未設定 SKU，庫存功能未啟用。</div>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>SKU</th>
                  <th>條碼</th>
                  <th>成本(HKD)</th>
                  <th>成本(JPY)</th>
                  <th>批發(HKD)</th>
                  <th>售價</th>
                  <th>庫存</th>
                  <th>啟用</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="sku-tbody"></tbody>
            </table>
            <div id="sku-adjust-modal" class="hidden space-y-2 p-3 border border-gray-200 rounded">
              <div class="font-bold">庫存調整</div>
              <div class="grid grid-cols-2 gap-2">
                <label class="text-sm block">
                  <div class="mb-1">SKU ID</div>
                  <input id="sku-adjust-sku-id" class="admin-input w-full" readonly />
                </label>
                <label class="text-sm block">
                  <div class="mb-1">調整數量</div>
                  <input id="sku-adjust-delta" class="admin-input w-full" type="number" step="1" />
                </label>
              </div>
              <label class="text-sm block">
                <div class="mb-1">備註（可選）</div>
                <textarea id="sku-adjust-note" class="admin-input w-full" rows="2"></textarea>
              </label>
              <div class="flex gap-2">
                <button id="sku-adjust-confirm" class="admin-btn" type="button">確認</button>
                <button id="sku-adjust-cancel" class="admin-btn-secondary" type="button">取消</button>
              </div>
            </div>
          </div>
          <div class="flex gap-2">
            <button id="product-save" class="admin-btn" type="submit">儲存</button>
            <button id="product-reset" class="admin-btn-secondary" type="button">清空</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/products.js"></script>
</div>
