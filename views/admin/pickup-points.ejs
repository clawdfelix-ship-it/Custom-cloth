<div id="admin-pickup-points" class="space-y-3">
  <div id="pp-error" class="admin-error hidden"></div>

  <div class="flex flex-wrap gap-2 items-center justify-between">
    <div class="font-bold">提貨點列表</div>
    <button id="pp-create" class="admin-btn" type="button">新增提貨點</button>
  </div>

  <div class="admin-card space-y-2">
    <div class="flex flex-wrap gap-2 items-end">
      <label class="text-sm">
        <div class="mb-1">地區篩選</div>
        <select id="pp-filter-district" class="admin-input">
          <option value="">全部地區</option>
        </select>
      </label>
      <label class="text-sm">
        <div class="mb-1">服務商篩選</div>
        <input id="pp-filter-provider" class="admin-input" placeholder="服務商代碼" list="pp-provider-list" />
      </label>
      <button id="pp-search" class="admin-btn-secondary" type="button">篩選</button>
    </div>
    <table class="admin-table">
      <thead>
        <tr>
          <th>名稱</th>
          <th>地址</th>
          <th>地區</th>
          <th>服務商</th>
          <th>緯度</th>
          <th>經度</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="pp-tbody"></tbody>
    </table>
    <div class="flex flex-wrap gap-2 items-center justify-between">
      <div id="pp-page-info" class="text-sm text-gray-600"></div>
      <div class="flex gap-2">
        <button id="pp-prev" class="admin-btn-secondary" type="button">上一頁</button>
        <button id="pp-next" class="admin-btn-secondary" type="button">下一頁</button>
      </div>
    </div>
  </div>

  <!-- ============ 新增 / 編輯提貨點彈窗 ============ -->
  <div id="pp-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="pp-modal-title">新增 / 編輯提貨點</div>
        <button id="pp-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-2 gap-2">
          <input id="pp-id" class="admin-input hidden" />
          <input id="pp-name" class="admin-input col-span-2" placeholder="點位名稱（例如：OK 便利店中環店）" />
          <input id="pp-address" class="admin-input col-span-2" placeholder="詳細地址" />
          <label class="text-sm">
            <div class="mb-1">地區</div>
            <select id="pp-district" class="admin-input"></select>
          </label>
          <input id="pp-provider" class="admin-input" placeholder="服務商代碼（711 / circlek / alfamart / store）" list="pp-provider-list" />
          <datalist id="pp-provider-list">
            <option value="lokocker"></option>
            <option value="711"></option>
            <option value="circlek"></option>
            <option value="alfamart"></option>
            <option value="store"></option>
          </datalist>
          <input id="pp-lat" class="admin-input" type="number" step="0.000001" placeholder="緯度（可留空）" />
          <input id="pp-lng" class="admin-input" type="number" step="0.000001" placeholder="經度（可留空）" />
        </div>
        <div class="flex gap-2 pt-2">
          <button id="pp-save" class="admin-btn" type="button">儲存</button>
          <button id="pp-reset" class="admin-btn-secondary" type="button">清空</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/pickup-points.js"></script>
</div>
