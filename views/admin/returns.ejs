<div id="admin-returns" class="space-y-3">
  <div class="flex flex-wrap gap-2 items-end">
    <label class="text-sm">
      <div class="mb-1">狀態</div>
      <select id="returns-status" class="admin-input">
        <option value="">全部</option>
        <option value="pending">待審批</option>
        <option value="approved">已批准</option>
        <option value="in_transit">退回中</option>
        <option value="received">已收貨</option>
        <option value="inspected">已驗貨</option>
        <option value="refunded">已退款</option>
        <option value="rejected">已拒絕</option>
      </select>
    </label>
    <button id="returns-refresh" class="admin-btn">刷新</button>
  </div>

  <div id="returns-error" class="admin-error hidden"></div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>訂單</th>
          <th>客戶</th>
          <th>狀態</th>
          <th>建立時間</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="returns-tbody"></tbody>
    </table>
  </div>

  <!-- ============ 售後詳情彈窗 ============ -->
  <div id="return-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-3xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg">售後詳情</div>
        <button id="return-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>
      <div class="p-4">
        <div id="return-detail" class="text-sm text-gray-700">請喺列表揀一張售後單</div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/returns.js"></script>
</div>

