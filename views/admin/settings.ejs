<div id="admin-settings" class="max-w-2xl space-y-4">

  <div class="admin-card">
    <div class="font-black mb-1">日元 → 港幣 匯率</div>
    <p class="text-sm text-gray-500 mb-3">
      mzakka 商品原價係日元，前台以港幣標價。一鍵拉取最新匯率後，可順手按原始日元重算全店商品價格。
    </p>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 rounded-lg bg-gray-50 p-3 text-sm">
      <div>現行匯率：<span id="rate-current" class="font-bold text-[#008060]">—</span>
        <span class="text-gray-500">（1 円 = ? HKD）</span>
      </div>
      <div>來源：<span id="rate-source" class="font-bold">—</span></div>
      <div>上次更新：<span id="rate-updated" class="font-bold">—</span></div>
      <div>受影響商品：<span id="rate-count" class="font-bold">—</span> 件</div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button id="rate-fetch" class="admin-btn" type="button">一鍵更新匯率</button>
      <button id="rate-reload" class="admin-btn-secondary" type="button">刷新狀態</button>
    </div>
    <p id="rate-live-hint" class="mt-2 text-xs text-gray-500">
      一鍵更新會由 Frankfurter（歐洲央行數據）取得最新 JPY→HKD；若線上匯率低過現行值，會自動保留較高者，唔會自動減價。
    </p>
  </div>

  <div class="admin-card">
    <div class="font-black mb-2">手動設定匯率</div>
    <div class="flex flex-wrap items-end gap-2">
      <label class="text-sm">
        <div class="mb-1">1 円 = 多少 HK$（例如 0.052）</div>
        <input id="rate-manual" type="number" step="0.0001" min="0.0001" max="0.9999"
               class="admin-input" placeholder="0.052" style="min-width:180px" />
      </label>
      <button id="rate-save-manual" class="admin-btn" type="button">儲存</button>
    </div>
  </div>

  <div class="admin-card">
    <label class="flex items-center gap-2 text-sm">
      <input id="rate-recompute" type="checkbox" checked />
      <span>更新匯率後，自動按原始日元重算全店 mzakka 商品價格</span>
    </label>
    <p class="mt-1 text-xs text-gray-500">
      原始日元存於商品 raw_payload，重算毋須重新爬取。取消打勾則只改匯率、郁唔到現有標價。
    </p>
    <div id="rate-preview" class="mt-3 hidden text-sm"></div>
  </div>

  <div id="rate-msg" class="admin-error hidden"></div>

  <!-- ============================================================== -->
  <!-- 積分系統設定 -->
  <!-- ============================================================== -->
  <div class="admin-card">
    <div class="font-black mb-1">積分系統</div>
    <p class="text-sm text-gray-500 mb-3">
      客人消費可賺積分，下次購物用積分即時扣錢。設定即時生效。
    </p>

    <label class="flex items-center gap-2 text-sm mb-4">
      <input id="pts-enabled" type="checkbox" />
      <span>啟用積分系統（關閉後唔會發分，結帳亦唔可兌換）</span>
    </label>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="text-sm">
        <div class="mb-1">每幾多港幣消費賺 1 分（例如 100）</div>
        <input id="pts-earn" type="number" min="1" step="1" class="admin-input" placeholder="100" />
      </label>
      <label class="text-sm">
        <div class="mb-1">每幾多分兌 HK$1 折扣（例如 100）</div>
        <input id="pts-redeem" type="number" min="1" step="1" class="admin-input" placeholder="100" />
      </label>
      <label class="text-sm">
        <div class="mb-1">每次最低兌換分數（例如 100）</div>
        <input id="pts-min" type="number" min="0" step="1" class="admin-input" placeholder="100" />
      </label>
      <label class="text-sm">
        <div class="mb-1">積分過期日數（0 = 唔過期）</div>
        <input id="pts-expiry" type="number" min="0" step="1" class="admin-input" placeholder="0" />
      </label>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button id="pts-save" class="admin-btn" type="button">儲存積分設定</button>
      <button id="pts-reload" class="admin-btn-secondary" type="button">刷新</button>
    </div>
    <p id="pts-msg" class="mt-2 text-xs"></p>
  </div>
</div>

<script>
(function () {
  const $ = (id) => document.getElementById(id);
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  const msg = $('rate-msg');

  function showMsg(text, ok) {
    msg.textContent = text;
    msg.classList.toggle('hidden', !text);
    msg.style.background = ok ? '#ecfdf5' : '#fef2f2';
    msg.style.color = ok ? '#065f46' : '#991b1b';
    if (text) setTimeout(() => msg.classList.add('hidden'), 6000);
  }

  async function api(url, options) {
    const res = await fetch(url, Object.assign({
      headers: { 'content-type': 'application/json', 'csrf-token': csrf },
      credentials: 'same-origin',
    }, options || {}));
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || ('請求失敗 (' + res.status + ')'));
    return data;
  }

  function sourceLabel(s) {
    return { db: '後台設定', env: '環境變數', default: '系統預設' }[s] || s || '—';
  }
  function fmtTime(t) {
    if (!t) return '未設定';
    try { return new Date(t).toLocaleString('zh-HK', { hour12: false }); }
    catch (_) { return String(t); }
  }

  async function load() {
    try {
      const d = await api('/api/admin/settings/exchange-rate');
      $('rate-current').textContent = Number(d.rate).toFixed(5);
      $('rate-source').textContent = sourceLabel(d.source);
      $('rate-updated').textContent = fmtTime(d.updatedAt);
      $('rate-count').textContent = d.affectedProducts;
    } catch (e) { showMsg(e.message, false); }
  }

  function recomputeOn() { return $('rate-recompute').checked; }

  async function runFetch() {
    const btn = $('rate-fetch');
    btn.disabled = true;
    btn.textContent = '更新中…';
    try {
      const d = await api('/api/admin/settings/exchange-rate/fetch', {
        method: 'POST',
        body: JSON.stringify({ recompute: recomputeOn() }),
      });
      const detail = d.message || ('已更新至 ' + Number(d.rate).toFixed(5));
      showMsg(
        detail +
        (d.recomputed && d.reprice ? ` 已重算 ${d.reprice.changed} 件商品（掃描 ${d.reprice.scanned} 件）。` : '（未重算標價）。'),
        true
      );
      await load();
    } catch (e) { showMsg(e.message, false); }
    finally { btn.disabled = false; btn.textContent = '一鍵更新匯率'; }
  }

  async function runManual() {
    const v = parseFloat($('rate-manual').value);
    if (!Number.isFinite(v) || v <= 0 || v >= 1) {
      showMsg('請輸入 0 至 1 之間嘅匯率（例如 0.052）。', false);
      return;
    }
    const btn = $('rate-save-manual');
    btn.disabled = true;
    try {
      const d = await api('/api/admin/settings/exchange-rate/manual', {
        method: 'POST',
        body: JSON.stringify({ rate: v, recompute: recomputeOn() }),
      });
      showMsg(
        '已儲存 ' + Number(d.rate).toFixed(5) +
        (d.recomputed && d.reprice ? `，重算了 ${d.reprice.changed} 件商品。` : '（未重算標價）。'),
        true
      );
      await load();
    } catch (e) { showMsg(e.message, false); }
    finally { btn.disabled = false; }
  }

  $('rate-fetch').addEventListener('click', runFetch);
  $('rate-save-manual').addEventListener('click', runManual);
  $('rate-reload').addEventListener('click', load);
  load();
})();
</script>

<script>
(function () {
  const $ = (id) => document.getElementById(id);
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  const msg = $('pts-msg');

  function showMsg(text, ok) {
    msg.textContent = text;
    msg.style.color = ok ? '#065f46' : '#991b1b';
    if (text) setTimeout(() => { msg.textContent = ''; }, 6000);
  }

  async function loadPoints() {
    try {
      const r = await fetch('/api/admin/settings/points', {
        headers: { 'csrf-token': csrf },
        credentials: 'same-origin',
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || '讀取失敗');
      $('pts-enabled').checked = !!d.enabled;
      $('pts-earn').value = d.earnHkd;
      $('pts-redeem').value = d.redeemHkd;
      $('pts-min').value = d.minRedeem;
      $('pts-expiry').value = d.expiryDays;
    } catch (e) { showMsg(e.message, false); }
  }

  $('pts-save').addEventListener('click', async () => {
    const body = {
      enabled: $('pts-enabled').checked,
      earnHkd: parseInt($('pts-earn').value, 10),
      redeemHkd: parseInt($('pts-redeem').value, 10),
      minRedeem: parseInt($('pts-min').value, 10),
      expiryDays: parseInt($('pts-expiry').value, 10),
    };
    const btn = $('pts-save');
    btn.disabled = true;
    try {
      const r = await fetch('/api/admin/settings/points', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'csrf-token': csrf },
        body: JSON.stringify(body),
        credentials: 'same-origin',
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || '儲存失敗');
      showMsg('積分設定已儲存。', true);
      await loadPoints();
    } catch (e) { showMsg(e.message, false); }
    finally { btn.disabled = false; }
  });

  $('pts-reload').addEventListener('click', loadPoints);
  loadPoints();
})();
</script>
