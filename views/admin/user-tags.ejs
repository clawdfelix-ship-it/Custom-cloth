<div id="admin-user-tags" class="space-y-3">
  <div id="ut-error" class="admin-error hidden"></div>

  <div class="flex flex-wrap gap-2 items-center justify-between">
    <div class="font-bold">標籤列表</div>
    <button id="ut-create" class="admin-btn" type="button">新增用戶標籤</button>
  </div>

  <div class="admin-card">
    <div class="flex items-center justify-end mb-2">
      <button id="ut-refresh" class="admin-btn-secondary" type="button">刷新</button>
    </div>
    <table class="admin-table">
      <thead>
        <tr>
          <th>名稱</th>
          <th>描述</th>
          <th>顏色</th>
          <th>建立時間</th>
        </tr>
      </thead>
      <tbody id="ut-tbody"></tbody>
    </table>
  </div>

  <!-- ============ 新增用戶標籤彈窗 ============ -->
  <div id="ut-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="ut-modal-title">新增用戶標籤</div>
        <button id="ut-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-2 gap-2">
          <input id="ut-name" class="admin-input" placeholder="標籤名稱（必填，最多 50 字）" maxlength="50" />
          <label class="text-sm">
            <div class="mb-1">標籤顏色</div>
            <div class="flex gap-2 items-center">
              <input id="ut-color" type="color" class="admin-input h-9 w-14 p-1" value="#4f46e5" />
              <input id="ut-color-text" class="admin-input grow" placeholder="例如 #4f46e5 或 blue" maxlength="20" />
            </div>
          </label>
          <textarea id="ut-description" class="admin-input col-span-2" rows="2" placeholder="描述（可留空）"></textarea>
        </div>
        <div class="flex gap-2 pt-2">
          <button id="ut-save" class="admin-btn" type="button">新增標籤</button>
          <button id="ut-reset" class="admin-btn-secondary" type="button">清空</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/user-tags.js"></script>
</div>
