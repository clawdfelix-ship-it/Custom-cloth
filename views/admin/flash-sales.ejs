<div id="admin-flash-sales" class="space-y-3">
  <div id="fs-error" class="admin-error hidden"></div>

  <div class="flex flex-wrap gap-2 items-center justify-between">
    <div class="font-bold">閃購活動列表</div>
    <button id="fs-create" class="admin-btn" type="button">新增閃購活動</button>
  </div>

  <!-- ============ 閃購活動 新增彈窗 ============ -->
  <div id="fs-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="fs-modal-title">新增閃購活動</div>
        <button id="fs-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>

      <div class="p-4">
        <div class="space-y-3">
          <div class="space-y-2">
            <div class="text-sm font-semibold">活動資料</div>
            <div class="grid grid-cols-2 gap-2">
              <input id="fs-name" class="admin-input" placeholder="活動名稱" />
              <input id="fs-description" class="admin-input" placeholder="活動描述（可空）" />
              <input id="fs-starts-at" class="admin-input" type="datetime-local" />
              <input id="fs-ends-at" class="admin-input" type="datetime-local" />
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="text-sm font-semibold">閃購商品</div>
              <button id="fs-add-row" class="admin-btn-secondary" type="button">加商品行</button>
            </div>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>商品 ID</th>
                  <th>閃購價 HK$</th>
                  <th>原價 HK$</th>
                  <th>限購數量</th>
                  <th>排序</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="fs-rows"></tbody>
            </table>
          </div>

          <div class="flex gap-2">
            <button id="fs-save" class="admin-btn" type="button">建立活動</button>
            <button id="fs-reset" class="admin-btn-secondary" type="button">清空</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>活動名稱</th>
          <th>開始</th>
          <th>結束</th>
          <th>狀態</th>
          <th>建立時間</th>
        </tr>
      </thead>
      <tbody id="fs-tbody"></tbody>
    </table>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/flash-sales.js"></script>
</div>
