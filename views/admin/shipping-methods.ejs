<div id="admin-shipping-methods" class="space-y-3">
  <div id="sm-error" class="admin-error hidden"></div>

  <div class="flex flex-wrap gap-2 items-center justify-between">
    <div class="font-bold">運送方式列表</div>
    <button id="sm-create" class="admin-btn" type="button">新增運送方式</button>
  </div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>名稱</th>
          <th>類型</th>
          <th>區域</th>
          <th>服務商</th>
          <th>運費</th>
          <th>免運門檻</th>
          <th>排序</th>
          <th>狀態</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="sm-tbody"></tbody>
    </table>
  </div>

  <!-- ============ 新增 / 編輯運送方式彈窗 ============ -->
  <div id="sm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="sm-modal-title">新增 / 編輯運送方式</div>
        <button id="sm-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-2 gap-2">
          <input id="sm-id" class="admin-input hidden" />
          <input id="sm-name" class="admin-input col-span-2" placeholder="方式名稱（例如：順豐速運）" />
          <label class="text-sm">
            <div class="mb-1">類型</div>
            <select id="sm-type" class="admin-input">
              <option value="courier">速遞（courier）</option>
              <option value="pickup">智能櫃自取（pickup）</option>
              <option value="self_pickup">店舖自取（self_pickup）</option>
            </select>
          </label>
          <label class="text-sm">
            <div class="mb-1">配送區域</div>
            <select id="sm-zone" class="admin-input">
              <option value="">（不限區域）</option>
            </select>
          </label>
          <input id="sm-provider" class="admin-input" placeholder="服務商代碼（sf_express / hongkong_post / kerry）" list="sm-provider-list" />
          <datalist id="sm-provider-list">
            <option value="sf_express"></option>
            <option value="hongkong_post"></option>
            <option value="kerry"></option>
            <option value="pickup"></option>
          </datalist>
          <input id="sm-fee" class="admin-input" type="number" min="0" step="0.01" placeholder="運費（HK$）" />
          <input id="sm-free-threshold" class="admin-input" type="number" min="0" step="0.01" placeholder="滿額免運門檻（HK$，可留空）" />
          <input id="sm-sort" class="admin-input" type="number" step="1" placeholder="排序（數字細排前）" />
          <label class="text-sm flex items-center gap-2">
            <input id="sm-active" type="checkbox" />
            <span>啟用</span>
          </label>
        </div>
        <div class="flex gap-2 pt-2">
          <button id="sm-save" class="admin-btn" type="button">儲存</button>
          <button id="sm-reset" class="admin-btn-secondary" type="button">清空</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/shipping-methods.js"></script>
</div>
