<div id="admin-warehouses" class="space-y-3">
  <div class="flex flex-wrap gap-2 items-center justify-between">
    <div class="font-bold">倉庫列表</div>
    <div class="flex gap-2">
      <button id="wh-create" class="admin-btn" type="button">新增倉庫</button>
      <button id="wh-refresh" class="admin-btn-secondary" type="button">刷新</button>
    </div>
  </div>

  <div id="wh-error" class="admin-error hidden"></div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>倉庫</th>
          <th>地址</th>
          <th>聯絡人</th>
          <th>電話</th>
          <th>狀態</th>
          <th>預設</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="wh-tbody"></tbody>
    </table>
  </div>

  <!-- ============ 新增倉庫彈窗 ============ -->
  <div id="wh-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg" id="wh-modal-title">新增倉庫</div>
        <button id="wh-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>
      <div class="p-4">
        <div class="space-y-2">
          <label class="text-sm block">
            <div class="mb-1">倉庫名</div>
            <input id="wh-name" class="admin-input w-full" placeholder="例如：預設倉庫" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">地址</div>
            <input id="wh-address" class="admin-input w-full" placeholder="可留空" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">聯絡人</div>
            <input id="wh-contact-name" class="admin-input w-full" placeholder="可留空" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">電話</div>
            <input id="wh-contact-phone" class="admin-input w-full" placeholder="可留空" />
          </label>
          <label class="text-sm flex items-center gap-2">
            <input id="wh-is-default" type="checkbox" />
            <span>設為預設</span>
          </label>
          <div class="flex gap-2 pt-1">
            <button id="wh-save" class="admin-btn" type="button">儲存</button>
            <button id="wh-reset" class="admin-btn-secondary" type="button">清空</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/warehouses.js"></script>
</div>
