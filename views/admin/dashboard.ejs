<div id="dashboard-error" class="admin-error hidden mb-3"></div>

<%
  // 訂單狀態 → 顯示 / 配色（沿用 design system）
  const orderStatus = {
    pending: { label: '待處理', cls: 'pending' },
    paid: { label: '已付款', cls: 'paid' },
    shipping: { label: '運送中', cls: 'shipping' },
    completed: { label: '已完成', cls: 'completed' },
    cancelled: { label: '已取消', cls: 'cancelled' },
  };
%>

<!-- Hero：超大細體標語 -->
<div class="dash-hero">
  <h2 class="dash-hero-title">早安，<%= (typeof adminName !== 'undefined' ? adminName : '商家') %>。</h2>
  <p class="dash-hero-sub">今日有 <strong id="hero-actionable">—</strong> 張訂單等你跟進。</p>
</div>

<!-- 三個並排大數字 -->
<div class="dash-bignumbers">
  <div class="dash-big">
    <div class="dash-big-value" id="big-today-orders">—</div>
    <div class="dash-big-unit">今日訂單（張）</div>
  </div>
  <div class="dash-big">
    <div class="dash-big-value" id="big-today-revenue">—</div>
    <div class="dash-big-unit">今日營業額（HK$）</div>
  </div>
  <div class="dash-big">
    <div class="dash-big-value" id="big-week-revenue">—</div>
    <div class="dash-big-unit">本週營業額（HK$）</div>
  </div>
</div>

<!-- 橫貫分段比例條：訂單狀態分佈 -->
<div class="admin-card dash-seg-card">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-semibold text-gray-700">訂單狀態分佈</h3>
    <span class="text-xs text-gray-400" id="seg-total">—</span>
  </div>
  <div class="dash-segbar" id="order-segbar"></div>
  <div class="dash-seg-legend" id="order-seg-legend"></div>
</div>

<!-- KPI -->
<div class="admin-kpi-grid" id="stats-grid"></div>

<div class="admin-grid-2 mt-4">
  <div class="admin-card">
    <h3 class="text-base font-semibold mb-3">最新訂單</h3>
    <div style="overflow-x:auto;">
    <table class="admin-table">
      <thead>
        <tr>
          <th>訂單號</th>
          <th>用戶</th>
          <th>金額</th>
          <th>狀態</th>
          <th>時間</th>
        </tr>
      </thead>
      <tbody id="recent-orders-tbody"></tbody>
    </table>
    </div>
  </div>

  <div class="admin-card">
    <h3 class="text-base font-semibold mb-3">快捷操作</h3>
    <div class="flex flex-col gap-2">
      <a href="/admin/products" class="admin-btn justify-start">📦 管理商品</a>
      <a href="/admin/coupons" class="admin-btn-secondary justify-start">🎟️ 建立優惠券</a>
      <a href="/admin/reports" class="admin-btn-secondary justify-start">📊 查看報表</a>
      <a href="/admin/orders" class="admin-btn-secondary justify-start">🧾 全部訂單</a>
    </div>
  </div>
</div>

<script src="/js/admin/common.js"></script>
<script src="/js/admin/dashboard.js"></script>
