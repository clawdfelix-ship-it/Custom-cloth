<div id="admin-categories" class="space-y-3">
  <div class="flex gap-2">
    <button id="categories-refresh" class="admin-btn">刷新</button>
    <button id="categories-new" class="admin-btn">新增分類</button>
  </div>

  <div id="categories-error" class="admin-error hidden"></div>

  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>分類</th>
          <th>Slug</th>
          <th>排序</th>
          <th>狀態</th>
          <th>商品數</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="categories-tbody"></tbody>
    </table>
  </div>

  <!-- ============ 分類編輯彈窗（新增／編輯即喺眼前打開） ============ -->
  <div id="categories-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-lg max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div id="categories-modal-title" class="font-bold text-lg">分類編輯</div>
        <button id="categories-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>

      <div class="p-4">
        <form id="category-form" class="space-y-2">
          <input type="hidden" id="category-id" />
          <label class="text-sm block">
            <div class="mb-1">上級分類</div>
            <select id="category-parent" class="admin-input w-full">
              <option value="">（無，上級＝大分類）</option>
            </select>
          </label>
          <label class="text-sm block">
            <div class="mb-1">名稱</div>
            <input id="category-name" class="admin-input w-full" required />
          </label>
          <label class="text-sm block">
            <div class="mb-1">Slug</div>
            <input id="category-slug" class="admin-input w-full" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">排序</div>
            <input id="category-sort" class="admin-input w-full" type="number" step="1" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">狀態</div>
            <select id="category-status" class="admin-input w-full">
              <option value="active">啟用</option>
              <option value="inactive">停用</option>
            </select>
          </label>
          <div class="flex gap-2">
            <button id="category-save" class="admin-btn" type="submit">儲存</button>
            <button id="category-reset" class="admin-btn-secondary" type="button">清空</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/categories.js"></script>
</div>
