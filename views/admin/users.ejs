<div id="admin-users" class="space-y-3">
  <div class="flex flex-wrap gap-2 items-end">
    <label class="text-sm">
      <div class="mb-1">搜尋（用戶名/電郵/電話）</div>
      <input id="users-search" class="admin-input" placeholder="例如：felix / 9xxxxxxx" />
    </label>
    <button id="users-refresh" class="admin-btn">刷新</button>
    <button id="users-new" class="admin-btn">新增用戶</button>
  </div>

  <div id="users-error" class="admin-error hidden"></div>

  <div class="admin-card">
    <div class="overflow-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>用戶名</th>
            <th>電郵</th>
            <th>電話</th>
            <th>狀態</th>
            <th>管理員</th>
            <th>B2B</th>
            <th>角色</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="users-tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- ============ 用戶編輯彈窗（一㩒編輯即喺眼前打開） ============ -->
  <div id="user-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-lg max-h-[90vh] overflow-auto rounded-xl bg-white shadow-2xl">
      <div class="sticky top-0 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3">
        <div class="font-bold text-lg">用戶編輯</div>
        <button id="user-modal-close" type="button" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">&times;</button>
      </div>

      <div class="p-4">
        <form id="user-form" class="space-y-2">
          <input type="hidden" id="user-id" />
          <label class="text-sm block">
            <div class="mb-1">用戶名</div>
            <input id="user-username" class="admin-input w-full" required />
          </label>
          <label class="text-sm block">
            <div class="mb-1">電郵</div>
            <input id="user-email" class="admin-input w-full" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">電話</div>
            <input id="user-phone" class="admin-input w-full" />
          </label>
          <label class="text-sm block">
            <div class="mb-1">WhatsApp</div>
            <input id="user-whatsapp" class="admin-input w-full" />
          </label>
          <div class="grid grid-cols-2 gap-2">
            <label class="text-sm block">
              <div class="mb-1">啟用</div>
              <select id="user-active" class="admin-input w-full">
                <option value="true">是</option>
                <option value="false">否</option>
              </select>
            </label>
            <label class="text-sm block">
              <div class="mb-1">黑名單</div>
              <select id="user-blacklisted" class="admin-input w-full">
                <option value="false">否</option>
                <option value="true">是</option>
              </select>
            </label>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <label class="text-sm block">
              <div class="mb-1">管理員</div>
              <select id="user-admin" class="admin-input w-full">
                <option value="false">否</option>
                <option value="true">是</option>
              </select>
            </label>
            <label class="text-sm block">
              <div class="mb-1">B2B 批發客戶</div>
              <select id="user-b2b" class="admin-input w-full">
                <option value="false">否</option>
                <option value="true">是</option>
              </select>
            </label>
          </div>
          <label class="text-sm block">
            <div class="mb-1">角色</div>
            <select id="user-role" class="admin-input w-full"></select>
          </label>
          <label class="text-sm block" id="user-password-wrap">
            <div class="mb-1">密碼（新用戶必填）</div>
            <input id="user-password" class="admin-input w-full" type="password" />
          </label>
          <div class="flex gap-2 pt-1">
            <button id="user-save" class="admin-btn" type="submit">儲存</button>
            <button id="user-reset" class="admin-btn-secondary" type="button">清空</button>
            <button id="user-reset-password" class="admin-btn-secondary" type="button">重設密碼</button>
          </div>
        </form>

        <div id="user-password-modal" class="hidden space-y-2 p-3 border border-gray-200 rounded mt-3">
          <div class="font-bold">重設密碼</div>
          <label class="text-sm block">
            <div class="mb-1">新密碼（至少 6 位）</div>
            <input id="user-new-password" class="admin-input w-full" type="password" />
          </label>
          <div class="flex gap-2">
            <button id="user-password-confirm" class="admin-btn" type="button">確認</button>
            <button id="user-password-cancel" class="admin-btn-secondary" type="button">取消</button>
          </div>
        </div>

        <!-- 積分管理（要選中用戶先操作） -->
        <div class="mt-4 rounded-lg border border-gray-200 p-3" id="user-points-panel">
          <div class="flex items-center justify-between mb-2">
            <div class="font-bold">積分管理</div>
            <div class="text-sm">當前結餘：<span id="user-points-balance" class="font-black text-[#008060]">—</span> 分</div>
          </div>
          <div class="grid grid-cols-2 gap-2 mb-2">
            <label class="text-sm block">
              <div class="mb-1">加 / 減分數（減分用負數）</div>
              <input id="user-points-delta" type="number" step="1" class="admin-input w-full" placeholder="例如 200 或 -50" />
            </label>
            <label class="text-sm block">
              <div class="mb-1">原因（必寫，方便日後追溯）</div>
              <input id="user-points-reason" class="admin-input w-full" placeholder="例如：投訴補償 / 線下活動" />
            </label>
          </div>
          <div class="flex gap-2 mb-3">
            <button id="user-points-apply" class="admin-btn" type="button">執行調整</button>
            <button id="user-points-refresh" class="admin-btn-secondary" type="button">刷新流水</button>
          </div>
          <div class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-1">最近積分流水</div>
          <div class="max-h-40 overflow-auto rounded border border-gray-200">
            <table class="admin-table text-xs">
              <thead>
                <tr><th>時間</th><th>分</th><th>類型</th><th>說明</th></tr>
              </thead>
              <tbody id="user-points-tbody">
                <tr><td colspan="4" class="text-center text-gray-400 py-3">請先選擇用戶</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/users.js"></script>
</div>
