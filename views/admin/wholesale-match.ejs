<div id="admin-wholesale-match" class="space-y-3">
  <div class="flex flex-wrap gap-2 items-end">
    <label class="text-sm">
      <div class="mb-1">搜尋（商品 / JAN / SKU）</div>
      <input id="wm-search" class="admin-input" placeholder="例如：346/1001" />
    </label>
    <button id="wm-refresh" class="admin-btn">刷新</button>
  </div>

  <div id="wm-error" class="admin-error hidden"></div>
  <div class="text-sm text-gray-500">
    日本批發 JAN 自動比對相似度 50–70%，須逐項確認。確認後視為已驗；駁回會清走入貨價及批發價，避免錯價流出。
  </div>

  <div class="flex flex-wrap gap-2 items-end">
    <button id="wm-bulk-confirm" class="admin-btn" type="button">批量確認</button>
    <button id="wm-bulk-reject" class="admin-btn-secondary text-red-600" type="button">批量駁回</button>
  </div>

  <div class="admin-card">
    <div class="overflow-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th><input id="wm-select-all" type="checkbox" /></th>
            <th>商品</th>
            <th>SKU</th>
            <th>現條碼</th>
            <th>比對 JAN</th>
            <th>相似度</th>
            <th>日圓成本</th>
            <th>批發(HKD)</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="wm-tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="flex items-center gap-3 text-sm">
    <button id="wm-prev" class="admin-btn-secondary" type="button">上一頁</button>
    <span id="wm-page" class="tabular-nums">—</span>
    <button id="wm-next" class="admin-btn-secondary" type="button">下一頁</button>
  </div>

  <script src="/js/admin/common.js"></script>
  <script src="/js/admin/wholesale-match.js"></script>
</div>
