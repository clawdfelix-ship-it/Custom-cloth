<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-head') %>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">
  <% const centerModules = homeModules && Array.isArray(homeModules.center) ? homeModules.center : []; %>
  <% const featuredCategories = Array.isArray(categoriesTree) ? categoriesTree.slice(0, 8) : []; %>

  <%- include('partials/age-modal') %>

  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-7xl mx-auto px-3 py-6">
    <div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-6">
      <%- include('partials/sidebar-left') %>

      <div id="wrap_center" class="min-w-0" data-motion-blur>
        <section class="mz-beam mb-6 overflow-hidden rounded-3xl border border-gold/40 bg-gradient-to-br from-ink-800 to-ink-900 p-6 shadow-luxe sm:p-8">
          <div class="mz-rule-gold mb-5 w-24"></div>
          <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.28em] text-gold">OHYA2.0 Boutique</p>
              <h1 class="mz-display mt-3 text-3xl font-black leading-tight text-white sm:text-4xl">日本直送·私密精選</h1>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-gray-400">嚴選日本人氣男士護理及生活雜貨，新品定期到港，從講究包裝到用心交付，全程為你守住私隱。</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href="/products?page=1" class="rounded-full bg-wine px-6 py-3 text-sm font-bold text-white shadow-glow transition hover:bg-wine-light">立即選購</a>
              <a href="#featured-categories" class="rounded-full border border-gold/50 px-6 py-3 text-sm font-semibold text-gold-light transition hover:border-gold hover:bg-gold/10">熱門分類</a>
            </div>
          </div>
        </section>

        <% if (centerModules.length) { %>
          <section class="mb-6 grid gap-4 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
            <a href="<%= centerModules[0].href || '/products?page=1' %>" class="group relative overflow-hidden rounded-3xl border border-ink-600 shadow-card">
              <img src="<%= centerModules[0].image_url %>" alt="<%= centerModules[0].title || '活動' %>" fetchpriority="high" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            </a>
            <div class="grid gap-4">
              <% centerModules.slice(1, 3).forEach(module => { %>
                <a href="<%= module.href || '/products?page=1' %>" class="group relative overflow-hidden rounded-3xl border border-ink-600 shadow-card">
                  <img src="<%= module.image_url %>" alt="<%= module.title || '活動' %>" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
                </a>
              <% }) %>
            </div>
          </section>
        <% } %>

        <section id="featured-categories" class="mb-6 rounded-3xl border border-ink-600 bg-ink-850 p-6 shadow-card">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="mz-display text-xl font-black text-white">熱門分類</h2>
              <p class="mt-1 text-sm text-gray-400">由首頁直達最常睇嘅類別，快速搵到心水貨品</p>
            </div>
            <a href="/products?page=1" class="shrink-0 text-sm font-semibold text-gold-light hover:text-gold">瀏覽全部商品</a>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <% featuredCategories.forEach(category => { %>
              <a href="/products?category=<%= encodeURIComponent(category.slug) %>&page=1" class="group rounded-2xl border border-ink-600 bg-ink-800 px-4 py-4 transition hover:border-gold/50 hover:shadow-glow">
                <div class="text-sm font-bold text-gray-100 transition group-hover:text-gold-light"><%= category.name %></div>
                <div class="mt-1 text-xs text-gray-500"><%= category.count %> 件商品</div>
              </a>
            <% }) %>
          </div>
        </section>

        <%- include('partials/shipping-calendar') %>

        <section class="mb-6 grid gap-6 <%= hasRanking ? 'xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.6fr)]' : '' %>">
          <% if (hasRanking) { %>
          <section id="mzakka-ranking" class="overflow-hidden rounded-3xl border border-ink-600 bg-ink-850 shadow-card">
            <div class="border-b border-ink-600 px-5 py-4">
              <h2 class="mz-display text-xl font-black text-white">新到推介</h2>
              <p class="mt-1 text-sm text-gray-400">緊貼日本最新貨況，新商品排行榜</p>
            </div>
            <div class="divide-y divide-ink-700">
              <% (rankingProducts || []).slice(0, 6).forEach((p, idx) => { %>
                <a href="/product/<%= p.id %>" class="flex gap-3 px-5 py-4 transition hover:bg-ink-700/60">
                  <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-2xl bg-ink-700">
                    <% if (p.image) { %>
                      <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" decoding="async" class="h-full w-full rounded-2xl object-contain p-1">
                    <% } %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-xs font-bold tracking-wider text-gold">No. <%= idx + 1 %></div>
                    <div class="mt-1 line-clamp-2 text-sm font-bold text-gray-100"><%= p.name %></div>
                    <div class="mt-2 text-sm font-black text-wine-light"><%= formatPrice(p.price) %></div>
                  </div>
                </a>
              <% }) %>
              <% if (!rankingProducts || rankingProducts.length === 0) { %>
                <div class="px-5 py-8 text-sm text-gray-500">暫時未有商品</div>
              <% } %>
            </div>
          </section>
          <% } %>

          <section class="overflow-hidden rounded-3xl border border-ink-600 bg-ink-850 shadow-card">
            <div class="flex items-center justify-between border-b border-ink-600 px-5 py-4">
              <div>
                <h2 class="mz-display text-xl font-black text-white">最新上架</h2>
                <p class="mt-1 text-sm text-gray-400">新到港嘅人氣新品，緊貼日本最新貨況</p>
              </div>
              <a href="/products?page=1" class="text-sm font-semibold text-gold-light hover:text-gold">查看全部</a>
            </div>
            <div class="p-5">
              <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
                <% (newProducts || []).slice(0, 12).forEach(product => { %>
                  <div class="group flex flex-col overflow-hidden rounded-2xl border border-ink-600 bg-ink-800 transition hover:-translate-y-1 hover:border-gold/40 hover:shadow-glow">
                    <a href="/product/<%= product.id %>" class="mz-imgwell block aspect-square" aria-label="<%= product.name %>">
                      <% if (product.image) { %>
                        <img src="<%= product.image %>" alt="" loading="lazy" decoding="async" class="h-full w-full object-contain p-2 transition duration-500 group-hover:scale-[1.03]">
                      <% } %>
                    </a>
                    <div class="flex flex-1 flex-col p-3">
                      <div class="truncate text-[11px] text-gold/80"><%= product.category %></div>
                      <div class="mt-1 min-h-[2.5rem] line-clamp-2 text-sm font-bold text-gray-100">
                        <a href="/product/<%= product.id %>" class="transition group-hover:text-gold-light"><%= product.name %></a>
                      </div>
                      <div class="mt-3 flex items-center justify-between gap-2">
                        <span class="text-sm font-black text-wine-light"><%= formatPrice(product.price) %></span>
                        <%# 預購模式：一律可加購 %>
                        <button type="button" data-add-to-cart data-product-id="<%= product.id %>" data-quantity="1" aria-label="加入購物車" class="flex min-h-[44px] items-center justify-center rounded-full border border-ink-500 px-4 text-xs font-semibold text-gray-300 transition hover:border-gold/60 hover:text-gold-light active:scale-95">
                            <span class="mzc-label">加入</span>
                          </button>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </section>
        </section>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script id="mz-products" type="application/json"><%- JSON.stringify(Object.values([...(rankingProducts || []), ...(newProducts || [])].reduce((m, p) => { if (p && p.id != null) m[p.id] = p; return m; }, {}))) %></script>
  <script src="/js/cart-client.js"></script>

  <script>
    // Age Verification
    function checkAgeVerification() {
      const verified = localStorage.getItem('ageVerified');
      if (!verified) {
        document.getElementById('ageModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    
    function verifyAge(isAdult) {
      if (isAdult) {
        localStorage.setItem('ageVerified', 'true');
        document.getElementById('ageModal').classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        window.location.href = 'https://www.google.com';
      }
    }
    
    // 購物車數字由共享 cart-client（MZCart.refreshCount）負責

    // Mobile Category Toggle
    function toggleCategories() {
      // Only run on mobile
      if (window.innerWidth < 1024) {
        const catList = document.getElementById('catList');
        const catToggle = document.getElementById('catToggle');
        if (catList.classList.contains('hidden')) {
          catList.classList.remove('hidden');
          catToggle.textContent = '▲';
        } else {
          catList.classList.add('hidden');
          catToggle.textContent = '▼';
        }
      }
    }
    
    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
      checkAgeVerification();
    });
  </script>
</body>
</html>
