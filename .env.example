# Neon PostgreSQL (direct endpoint, no -pooler for Prisma migrations)
DATABASE_URL="postgresql://USER:***@ep-xxx.us-east-2.aws.neon.tech/zenexsportscustom?sslmode=require"

# Session signing secret, at least 32 characters
SESSION_SECRET="generate-a-long-random-string-here-at-least-32-chars"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email for 2FA codes. Leave empty to log codes to the console.
RESEND_API_KEY=""
MAIL_FROM="Zenex Sports <no-reply@zenexsports.com>"
