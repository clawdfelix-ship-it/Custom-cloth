# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# For Vercel Postgres / Supabase / Neon / etc.
DATABASE_URL=postgresql://username:password@localhost:5432/mzakka_ecommerce

# Session
SESSION_SECRET=your-random-secret-key-change-me-in-production

# CORS allowlist (comma-separated)
CORS_ALLOWED_ORIGINS=

# CSP mode: report|enforce
CSP_MODE=report
# CSP report endpoint path
CSP_REPORT_PATH=/csp-report

# ShipAny Logistics Integration (optional)
SHIPANY_API_KEY=
SHIPANY_WEBHOOK_SECRET=
SHIPANY_WEBHOOK_ALLOWED_IPS=
SHIPANY_API_URL=https://api.shipany.com/v1
SHIPANY_SENDER_NAME=
SHIPANY_SENDER_PHONE=
SHIPANY_SENDER_ADDRESS=

# Manual payment collection (銀行轉帳 / FPS，結帳確認頁顯示)
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_FPS_ID=
PAYMENT_FPS_PHONE=

# JPY → HKD 匯率（1 日元兌多少港幣，預設 0.052；後台可一鍵覆蓋）
JPY_HKD_RATE=0.052

# Zoho Mail (SMTP) — 交易電郵（訂單確認 / 新訂單通知）
# Zoho 專用密碼或 App Password；唔係登入密碼。Port 465 (SSL) 或 587 (STARTTLS)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_MAIL_USER=
ZOHO_MAIL_PASS=
ZOHO_MAIL_FROM_NAME=Ohya
ZOHO_MAIL_FROM_ADDRESS=
# 後台新訂單通知收件箱（留空則發去 ZOHO_MAIL_USER）
ZOHO_ORDER_NOTIFY_ADDRESS=

# 每月 1 號自動更新匯率（HKT）。設 0/false 可關；AUTO_RATE_DAY_HOUR 控制幾點
AUTO_RATE_ENABLED=1
AUTO_RATE_DAY_HOUR=9
