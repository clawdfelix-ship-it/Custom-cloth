{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "crons": [
    {
      "path": "/api/internal/jobs/daily-sync/refresh",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/internal/jobs/daily-sync/process",
      "schedule": "34 23 * * *"
    },
    {
      "path": "/api/internal/jobs/daily-sync/process",
      "schedule": "42 23 * * *"
    },
    {
      "path": "/api/internal/jobs/daily-sync/process",
      "schedule": "50 23 * * *"
    },
    {
      "path": "/api/internal/jobs/mzakka-sync",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/internal/jobs/email-outbox",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
